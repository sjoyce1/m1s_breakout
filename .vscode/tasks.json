{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build M1s Breakout Firmware",
            "type": "shell",
            "command": "make",
            "args": [
                "CHIP=bl808",
                "BOARD=bl808_m1s_dock",
                "CPU_ID=d0",
                "-j8"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "make",
            "args": [
                "clean"
            ],
            "problemMatcher": []
        }
    ]
}
